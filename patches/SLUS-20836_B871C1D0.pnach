gametitle=Digimon World 4 (NTSC-U) [SLUS-20836]

[Mods\EXP per group]
author=Namek025
description=EXP per enemy: solo 100%, 2 players 80%, 3 players 60%, 4 players 50% each; no killer bonus (P2EEXPUP, docs/exp.md)
// share = exp * K (R5900 3-operand mult), jumps to the common split
// default (1 player): K = 100
patch=1,EE,003FF8DC,word,24020064
patch=1,EE,003FF8E0,word,10000031
patch=1,EE,003FF8E4,word,0202A818
// 2 players: K = 80
patch=1,EE,003FF910,word,24020050
patch=1,EE,003FF914,word,10000024
patch=1,EE,003FF918,word,0202A818
// 3 players: K = 60
patch=1,EE,003FF948,word,2402003C
patch=1,EE,003FF94C,word,10000016
patch=1,EE,003FF950,word,0202A818
// 4 players: K = 50
patch=1,EE,003FF970,word,24020032
patch=1,EE,003FF974,word,1000000C
patch=1,EE,003FF978,word,0202A818
// killer: / 50 -> / 100 (the others already divide by 100)
patch=1,EE,003FF9CC,word,00021143

[Mods\EXP x2]
author=Namek025
description=Every enemy gives double EXP. Same as halving the level curve. Can be combined with EXP per group.
// exp = enemy.EXP * 2  (was: move s0, v0)
patch=1,EE,003FF870,word,00428021

