[Debug\All evolutions unlocked]
author=Namek025
description=When each player's model spawns, the 16 forms are unlocked (BASE_ISUSE). This is saved with the game: use it with a test save.
// func_003D3640: the path for a player without ISUSE (stage with no save) fills BASE_ISUSE with 1; skips GAMESTART and goes straight to the fill
patch=1,EE,003D3C4C,word,1000001E
